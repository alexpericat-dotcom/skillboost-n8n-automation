    {
      "parameters": {
        "jsCode": "const inputItem = $input.item.json;\nconst emailBrut = inputItem.body?.email || inputItem.email || \"\";\n\n// 1. Nettoyage de base : minuscules, sans accents, sans espaces\nlet emailPropre = emailBrut\n  .toLowerCase()\n  .normalize(\"NFD\")\n  .replace(/[\\u0300-\\u036f]/g, \"\") // retire les accents\n  .replace(/\\s+/g, \"\")             // retire tous les espaces\n  .trim();\n\n// 2. Correction des fautes de frappe courantes sur les domaines\nconst correctionsDomaines = {\n  \"gmial.com\": \"gmail.com\",\n  \"gmai.com\": \"gmail.com\",\n  \"gmail.co\": \"gmail.com\",\n  \"gnail.com\": \"gmail.com\",\n  \"hotmial.com\": \"hotmail.com\",\n  \"hotmai.com\": \"hotmail.com\",\n  \"hotmil.com\": \"hotmail.com\",\n  \"yaho.com\": \"yahoo.com\",\n  \"yahou.fr\": \"yahoo.fr\",\n  \"outlok.com\": \"outlook.com\",\n  \"outllok.com\": \"outlook.com\",\n  \"orange.f\": \"orange.fr\",\n  \"wanadooo.fr\": \"wanadoo.fr\"\n};\n\nif (emailPropre.includes(\"@\")) {\n  let [partieLocale, domaine] = emailPropre.split(\"@\");\n\n  // Correction si le domaine est une faute connue\n  if (correctionsDomaines[domaine]) {\n    domaine = correctionsDomaines[domaine];\n  }\n\n  // Nettoyage des points multiples dans le domaine (ex: \"gmail..com\")\n  domaine = domaine.replace(/\\.{2,}/g, \".\");\n\n  emailPropre = `${partieLocale}@${domaine}`;\n}\n\n// 3. Récupération de l'ID de l'atelier et génération de la clé de déduplication\nconst idAtelier = inputItem.body?.atelier || inputItem.atelier || \"\";\nconst cleDeduplication = `${emailPropre}_${idAtelier}`;\n\n// 4. On retourne l'objet enrichi pour les nœuds suivants\nreturn {\n  json: {\n    ...inputItem,\n    email: emailPropre,\n    Clé_Deduplication: cleDeduplication\n  }\n};"
      },
