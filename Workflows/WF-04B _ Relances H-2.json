    {
      "parameters": {
        "sendTo": "=alexandre.pericat@gmail.com",
        "subject": "⏳ Votre atelier \"{{ $json.Nom_Atelier }}\" commence dans 2 heures !",
        "message": "=<div style=\"max-width: 600px; margin: 0 auto; font-family: Arial, sans-serif; color: #333333; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;\">\n\n    <!-- EN-TÊTE / LOGO -->\n    <div style=\"background-color: #f8f9fa; padding: 20px; text-align: center; border-bottom: 4px solid #5cb85c;\">\n        <h1 style=\"margin: 0; color: #2c3e50; font-size: 28px; letter-spacing: 1px;\">\n            <span style=\"color: #d9534f;\">🚀</span> SkillBoost\n        </h1>\n        <p style=\"margin: 5px 0 0 0; color: #7f8c8d; font-size: 14px;\">Préparez-vous, c'est le jour J !</p>\n    </div>\n\n    <!-- CORPS DU MESSAGE -->\n    <div style=\"padding: 30px;\">\n        <h2 style=\"margin-top: 0; color: #5cb85c;\">⏳ C'est presque l'heure !</h2>\n        \n        <p>Bonjour,</p>\n        \n        <p>Dernier petit rappel : votre atelier <strong>{{ $json.Nom_Atelier }}</strong> commence dans exactement <strong>2 heures</strong>.</p>\n        \n        <!-- BLOC INFOS PRATIQUES -->\n        <div style=\"background-color: #f4f6f8; padding: 20px; border-left: 4px solid #2c3e50; border-radius: 4px; margin: 25px 0;\">\n            <h3 style=\"margin-top: 0; color: #2c3e50; font-size: 16px;\">📌 Informations pratiques :</h3>\n            <ul style=\"list-style-type: none; padding: 0; margin: 0;\">\n                <li style=\"margin-bottom: 10px;\">\n                    <strong>📍 Lieu / Lien de connexion :</strong><br> \n                    {{ $json.Lieu }}\n                </li>\n                <li>\n                    <strong>🎒 Matériel à prévoir :</strong><br> \n                    {{ $json.Materiel }}\n                </li>\n            </ul>\n        </div>\n        \n        <p>Nous vous conseillons d'arriver (ou de vous connecter) avec 5 à 10 minutes d'avance pour vous installer tranquillement avant le début de la session.</p>\n        \n        <p style=\"margin-top: 30px; font-size: 14px;\">\n            À tout de suite !<br>\n            <strong>Le formateur et l'équipe SkillBoost</strong>\n        </p>\n    </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
