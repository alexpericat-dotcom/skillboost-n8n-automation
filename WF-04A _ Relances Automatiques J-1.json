    {
      "parameters": {
        "sendTo": "=alexandre.pericat@gmail.com",
        "subject": "Rappel : Votre atelier a lieu demain !",
        "message": "=<div style=\"max-width: 600px; margin: 0 auto; font-family: Arial, sans-serif; color: #333333; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;\">\n\n    <!-- EN-TÊTE / LOGO -->\n    <div style=\"background-color: #f8f9fa; padding: 20px; text-align: center; border-bottom: 4px solid #337ab7;\">\n        <h1 style=\"margin: 0; color: #2c3e50; font-size: 28px; letter-spacing: 1px;\">\n            <span style=\"color: #d9534f;\">🚀</span> SkillBoost\n        </h1>\n        <p style=\"margin: 5px 0 0 0; color: #7f8c8d; font-size: 14px;\">C'est pour demain !</p>\n    </div>\n\n    <!-- CORPS DU MESSAGE -->\n    <div style=\"padding: 30px;\">\n        <h2 style=\"margin-top: 0; color: #337ab7;\">⏰ Rappel : Votre atelier a lieu demain</h2>\n        \n        <p>Bonjour,</p>\n        \n        <p>Ceci est un petit rappel automatique pour vous rappeler votre participation à l'atelier :<br>\n        <strong>{{ $json.Nom_Atelier }}</strong></p>\n        \n        <h3 style=\"color: #2c3e50; border-bottom: 2px solid #eee; padding-bottom: 5px; margin-top: 25px;\">📌 Vos détails pratiques :</h3>\n        <ul style=\"line-height: 1.6;\">\n            <li><strong>📅 Date et heure :</strong> {{ $json.Date_Heure }}</li>\n            <li><strong>📍 Lieu / Lien :</strong> {{ $json.Lieu }}</li>\n            <li><strong>🎒 Matériel requis :</strong> {{ $json.Materiel }}</li>\n        </ul>\n        \n        <p><em>Pensez à vérifier votre matériel ou à tester votre lien de connexion un peu en avance.</em></p>\n        \n        <!-- SECTION URGENCE / EMPÊCHEMENT -->\n        <div style=\"background-color: #fff3f3; padding: 20px; border-radius: 5px; margin-top: 30px; border-left: 4px solid #d9534f;\">\n            <p style=\"margin-top: 0;\"><strong>Un empêchement de dernière minute ?</strong></p>\n            <p style=\"font-size: 14px;\">Si vous savez dès à présent que vous ne pourrez pas venir, merci de libérer votre place pour les personnes en liste d'attente :</p>\n            \n            <a href=\"https://vps-308cfbf7.vps.ovh.net/webhook/annulation-inscription\" style=\"background-color: #d9534f; color: white; padding: 10px 18px; text-decoration: none; border-radius: 5px; display: inline-block; font-weight: bold;\">Annuler ma participation</a>\n        </div>\n        \n        <p style=\"margin-top: 30px; font-size: 14px;\">\n            Nous avons hâte de vous y retrouver !<br>\n            <strong>L'équipe SkillBoost</strong>\n        </p>\n    </div>\n</div>",
